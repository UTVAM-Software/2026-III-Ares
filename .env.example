# Copiar a .env y completar; no subir .env a Git.
DJANGO_SECRET_KEY=GENERAR_UN_SECRETO_ALEATORIO
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DB_NAME=ares_db
DB_USER=postgres
DB_PASSWORD=COMPLETAR_LOCALMENTE
DB_HOST=localhost
DB_PORT=5500
# En HTTPS: DJANGO_DEBUG=0 y el origen real.
DJANGO_CSRF_TRUSTED_ORIGINS=
